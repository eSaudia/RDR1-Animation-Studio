<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RDR1AnimationStudio</AssemblyName>
    <RootNamespace>RDR1AnimationStudio</RootNamespace>
    <Version>0.12.0</Version>
    <ApplicationIcon>Assets\studio.ico</ApplicationIcon>
    <Product>RDR1 Animation Studio</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- The native XMem probe is built as a separate x86 helper. Keep both
         its modern source and the .NET Framework fallback out of the x64
         studio compilation. -->
    <Compile Remove="Tools\XMemProbe\**\*.cs" />
    <Content Include="Renderer\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Small .NET Framework x86 launcher; it loads the user's local
         xcompress32.dll and is invoked only by the explicit probe command. -->
    <Content Include="Tools\XMemProbe\Rdr1XMemProbe.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Tools\WasInspector\**\*" Exclude="Tools\WasInspector\**\__pycache__\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="RemoveUnusedWebView2WpfAssembly" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
</Project>
